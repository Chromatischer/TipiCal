pkgname=tipical-git
pkgver=r35.6cdcba8
pkgrel=1
pkgdesc="A fast, beautiful calendar interface for your terminal"
arch=('x86_64' 'aarch64')
url="https://github.com/Chromatischer/TipiCal"
license=('MIT')
depends=('glibc')
makedepends=('git' 'go')
provides=('tipical')
conflicts=('tipical')
source=("git+https://github.com/Chromatischer/TipiCal.git")
md5sums=('SKIP')

pkgver() {
	cd TipiCal
	printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
	cd TipiCal
	export CGO_CPPFLAGS="${CPPFLAGS}"
	export CGO_CFLAGS="${CFLAGS}"
	export CGO_CXXFLAGS="${CXXFLAGS}"
	export CGO_LDFLAGS="${LDFLAGS}"
	export GOFLAGS="-buildmode=pie -trimpath -ldflags=-linkmode=external -mod=readonly -modcacherw"
	go build -o tipical
}

package() {
	cd TipiCal
	install -Dm755 tipical "$pkgdir/usr/bin/tipical"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/tipical/LICENSE"
}
